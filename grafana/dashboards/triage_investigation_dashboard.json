{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "SECTION 1: SOC EXECUTIVE OVERVIEW & FLEET METRICS",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Total Fleet Endpoints",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": "Neo4j-Triage-Graph",
      "targets": [
        {
          "refId": "A",
          "rawCypher": "MATCH (e:Endpoint) RETURN count(e) AS value;"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Critical / High Priority Hosts",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 1 },
      "datasource": "Neo4j-Triage-Graph",
      "targets": [
        {
          "refId": "A",
          "rawCypher": "MATCH (e:Endpoint) WHERE e.priority_tier IN ['CRITICAL', 'HIGH'] RETURN count(e) AS value;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Malware Quarantines (Endpoints)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 1 },
      "datasource": "Neo4j-Triage-Graph",
      "targets": [
        {
          "refId": "A",
          "rawCypher": "MATCH (e:Endpoint) WHERE e.malicious_incident_count > 0 RETURN count(e) AS value;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
      }
    },
    {
      "id": 4,
      "title": "Web-Correlated Incidents",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 1 },
      "datasource": "Neo4j-Triage-Graph",
      "targets": [
        {
          "refId": "A",
          "rawCypher": "MATCH (e:Endpoint)-[c:CONTACTED]->(d:Destination) WHERE c.context = 'Pre_Quarantine_Window' RETURN count(DISTINCT e) AS value;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" }
        }
      }
    },
    {
      "id": 5,
      "title": "USB Mass Storage Attached",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "datasource": "Neo4j-Triage-Graph",
      "targets": [
        {
          "refId": "A",
          "rawCypher": "MATCH (u:USBDevice {is_mass_storage: true})<-[:CONNECTED_USB]-(e:Endpoint) RETURN count(DISTINCT e) AS value;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "yellow" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "SECTION 2: INVESTIGATION PRIORITY QUEUE",
      "type": "row"
    },
    {
      "id": 6,
      "title": "Triage Priority Ranking (Explainable Prioritization)",
      "type": "table",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 6 },
      "datasource": "Neo4j-Triage-Graph",
      "targets": [
        {
          "refId": "A",
          "rawCypher": "MATCH (e:Endpoint)\nRETURN e.endpoint_id AS Endpoint, e.priority_tier AS Tier, e.investigation_priority_score AS PriorityScore, e.behavioral_anomaly_score AS AnomalyScore, e.malicious_incident_count AS MaliciousIncidents, e.rare_destination_count AS RareDests, e.total_web_events AS WebEvents\nORDER BY PriorityScore DESC;"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Tier" },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "blue", "value": null },
                    { "color": "yellow", "value": 20 },
                    { "color": "orange", "value": 45 },
                    { "color": "red", "value": 70 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "PriorityScore" },
            "properties": [
              { "id": "custom.displayMode", "value": "gradient-gauge" },
              { "id": "min", "value": 0 },
              { "id": "max", "value": 100 }
            ]
          }
        ]
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 102,
      "title": "SECTION 3: ARTIFACT & WEAPONIZED LURE CLUSTERS",
      "type": "row"
    },
    {
      "id": 7,
      "title": "Quarantined Malware Artifacts & SHA-256 Hashes",
      "type": "table",
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 16 },
      "datasource": "Neo4j-Triage-Graph",
      "targets": [
        {
          "refId": "A",
          "rawCypher": "MATCH (e:Endpoint)-[q:QUARANTINED]->(f:File)-[:HAS_HASH]->(h:SHA256)\nWHERE q.is_malicious = true\nRETURN e.endpoint_id AS Host, f.name AS ArtifactFile, f.category AS Category, h.hash AS SHA256, q.quarantined_at AS IncidentTime, q.re_scan_sightings AS RescanCount\nORDER BY IncidentTime DESC;"
        }
      ]
    },
    {
      "id": 8,
      "title": "Multi-Host Malware Spread (Shared Artifacts)",
      "type": "table",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 16 },
      "datasource": "Neo4j-Triage-Graph",
      "targets": [
        {
          "refId": "A",
          "rawCypher": "MATCH (e:Endpoint)-[q:QUARANTINED]->(f:File)\nWHERE q.is_malicious = true\nWITH f, count(DISTINCT e) AS AffectedHosts, collect(DISTINCT e.endpoint_id) AS Hosts\nRETURN f.name AS MalwareArtifact, AffectedHosts, Hosts\nORDER BY AffectedHosts DESC;"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 103,
      "title": "SECTION 4: CROSS-SOURCE TEMPORAL CORRELATION TIMELINE",
      "type": "row"
    },
    {
      "id": 9,
      "title": "Pre-Incident Correlated Web Traffic (2-Hour Attack Window)",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 25 },
      "datasource": "Neo4j-Triage-Graph",
      "targets": [
        {
          "refId": "A",
          "rawCypher": "MATCH (e:Endpoint)-[c:CONTACTED]->(d:Destination)\nWHERE c.context = 'Pre_Quarantine_Window'\nRETURN e.endpoint_id AS Host, d.name AS ContactedDestination, c.event_time AS RequestTime, c.delta_minutes AS DeltaMinutesToQuarantine, c.incident_id AS IncidentID\nORDER BY Host, DeltaMinutesToQuarantine;"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "id": 104,
      "title": "SECTION 5: PERIPHERAL & USB AUDIT",
      "type": "row"
    },
    {
      "id": 10,
      "title": "USB Peripheral Connections & Device Classes",
      "type": "table",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 34 },
      "datasource": "Neo4j-Triage-Graph",
      "targets": [
        {
          "refId": "A",
          "rawCypher": "MATCH (e:Endpoint)-[r:CONNECTED_USB]->(u:USBDevice)\nRETURN e.endpoint_id AS Host, u.vid_pid AS HardwareID, u.device_class AS DeviceClass, u.is_mass_storage AS IsMassStorage, r.event_time AS PluggedTime, r.raw_message AS Telemetry\nORDER BY PluggedTime DESC;"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["cybersecurity", "soc", "triage", "incident-response", "neo4j"],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "name": "tier",
        "type": "custom",
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "selected": false, "text": "CRITICAL", "value": "CRITICAL" },
          { "selected": false, "text": "HIGH", "value": "HIGH" },
          { "selected": false, "text": "MEDIUM", "value": "MEDIUM" },
          { "selected": false, "text": "LOW", "value": "LOW" }
        ],
        "query": "CRITICAL,HIGH,MEDIUM,LOW",
        "includeAll": true
      }
    ]
  },
  "time": {
    "from": "2026-09-01T00:00:00.000Z",
    "to": "2026-09-30T23:59:59.000Z"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
